/* For information on how to configure Zed, see the Zed documentation: https://zed.dev/docs/configuring-zed */
{
  "hard_tabs": true,
  "project_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  }
}
