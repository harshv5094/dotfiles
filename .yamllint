---
extends: default

rules:
  # Dotfile configs (lazygit, etc.) already exceed 80 columns.
  line-length:
    max: 120
    level: warning

  # Existing files do not use a leading `---`.
  document-start: disable

  # GitHub Actions uses `on:` as a key.
  truthy:
    allowed-values: ["true", "false", "on"]
    check-keys: false

  comments:
    min-spaces-from-content: 1

  comments-indentation: disable

  # Allow inline maps such as `{read: true}` in the workflows.
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
