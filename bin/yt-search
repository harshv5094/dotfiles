#!/usr/bin/env bash

# SCRIPT NAME: yt-search
# AUTHOR: Harsh Vyapari (@harshv5094)

# Checking for dependencies
dependency_list=("yt-dlp" "fzf" "mpv")

# A safe exit loop for checking dependencies
for applications in "${dependency_list[@]}"; do
  if ! command -v "$applications" &>/dev/null; then
    printf "%b\n" "applications not found. Install it first."
    exit 1
  fi
done

cat <<'EOF'
__   _______   _____                     _     
\ \ / /_   _| /  ___|                   | |    
 \ V /  | |   \ `--.  ___  __ _ _ __ ___| |__  
  \ /   | |    `--. \/ _ \/ _` | '__/ __| '_ \ 
  | |   | |   /\__/ /  __/ (_| | | | (__| | | |
  \_/   \_/   \____/ \___|\__,_|_|  \___|_| |_|
EOF

# Function to fetch search results
search_youtube() {
  query="$1"
  yt-dlp "ytsearch6:${query}" \
    --flat-playlist \
    --print "%(id)s|%(title)s|%(channel)s|%(duration_string)s" \
    --playlist-end 6 \
    --skip-download \
    --quiet
}

if [[ $# -eq 0 ]]; then
  printf "%b\n" "Usage: yt-search <query>"
  exit 1
fi

query="$*"
echo "Searching for: $query..."

# Fetch results from youtube
results=$(search_youtube "$query")
if [[ -z "$results" ]]; then
  echo "No results found"
  exit 1
fi

selected=$(echo "$results" | fzf \
  --delimiter '|' \
  --with-nth 2 \
  --preview 'printf "%b\n" "URL: https://youtube.com/watch?v={1}\nTitle: {2}\nChannel: {3}\nDuration: {4}"' \
  --preview-window 'bottom' \
  --height 80% \
  --layout reverse \
  --header 'Select video to play (Ctrl-C to cancel)')

if [[ -n "$selected" ]]; then
  video_id=$(echo "$selected" | cut -d'|' -f1)
  video_title=$(echo "$selected" | cut -d'|' -f2)
  video_url="https://youtube.com/watch?v=${video_id}"
  echo "Playing: $video_title"

  history_file="$HOME/.ytsearch.txt"

  # Saving temporary history in $HOME/.ytsearch.txt
  if [[ ! -f $history_file ]]; then
    touch "$history_file"
    if ! grep -q "$video_title" "$history_file"; then
      echo "$video_title - $video_url" >>"$history_file"
    fi
  else
    if ! grep -q "$video_title" "$HOME/.ytsearch.txt"; then
      echo "$video_title - $video_url" >>"$history_file"
    fi
  fi
else
  printf "%b\n" "Not selected, exiting..."
  exit 0
fi

if command -v hyprctl &>/dev/null; then
  #shellcheck disable=SC2086
  #shellcheck disable=SC2027
  hyprctl dispatch "hl.dsp.exec_cmd('mpv "$video_url"', { workspace = 10 })"
else
  mpv "$video_url"
fi
