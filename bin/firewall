#!/usr/bin/env bash

have() { command -v "$1" &>/dev/null; }

cat <<'EOF'
______ _                        _ _   _____      _               
|  ___(_)                      | | | /  ___|    | |              
| |_   _ _ __ _____      ____ _| | | \ `--.  ___| |_ _   _ _ __  
|  _| | | '__/ _ \ \ /\ / / _` | | |  `--. \/ _ \ __| | | | '_ \ 
| |   | | | |  __/\ V  V / (_| | | | /\__/ /  __/ |_| |_| | |_) |
\_|   |_|_|  \___| \_/\_/ \__,_|_|_| \____/ \___|\__|\__,_| .__/ 
                                                          | |    
                                                          |_|    
EOF

# --- Detect escalation tool (sudo, doas, or root) ---
if [ "$(id -u)" -eq 0 ]; then
  ESCALATION_TOOL=""
elif have sudo; then
  ESCALATION_TOOL="sudo"
elif have doas; then
  ESCALATION_TOOL="doas"
else
  printf "%b\n" "No sudo/doas found, and not running as root. Exiting."
  exit 1
fi

# --- Detect package manager ---
if ! have ufw; then
  if have pacman; then
    $ESCALATION_TOOL pacman -S --noconfirm --needed ufw iptables
  elif have apt; then
    $ESCALATION_TOOL apt update
    $ESCALATION_TOOL apt install -y ufw
  elif have dnf; then
    $ESCALATION_TOOL dnf install -y ufw
  elif have zypper; then
    $ESCALATION_TOOL zypper install ufw
  else
    printf "%b\n" "No supported package manager found (pacman, apt, dnf). Exiting."
    exit 1
  fi
else
  printf "%b\n" "** UFW is installed **"
fi

# --- Configure ufw if installed ---
if have ufw; then
  printf "%b\n" "** Apply default firewall rules **"

  if ! grep -q "\[LocalSend\]" /etc/ufw/applications.d/ufw-fileserver; then
    printf "\n%b" "[LocalSend]
title=LocalSend
description=A Cross Platform File sharing application
ports=53317/udp|53317/tcp" | $ESCALATION_TOOL tee -a /etc/ufw/applications.d/ufw-fileserver
  fi

  $ESCALATION_TOOL ufw limit 22/tcp  # ssh
  $ESCALATION_TOOL ufw allow 80/tcp  # http
  $ESCALATION_TOOL ufw allow 443/tcp # https
  $ESCALATION_TOOL ufw allow LocalSend

  # Deny all incoming to all ports
  $ESCALATION_TOOL ufw default deny incoming

  # But allow all outgoing for ports
  $ESCALATION_TOOL ufw default allow outgoing

  printf "%b\n" "** Enable ufw service **"
  $ESCALATION_TOOL ufw enable
else
  printf "%b\n" "UFW installation failed or not found."
  exit 1
fi
